    { division: "ИТ-управление", department: "Отдел информационной безопасности", count: 1 },

    // ---------- Не отнесено к управлению ----------
    // Нет в списке ответов вопроса "Отдел" анкеты (Questions.gs) — см. заголовок файла.
    { division: null, department: "Отдел поддержки проектов", count: 2 },
    // Старое название — разрешится в "Отдел сетевых технологий" через DepartmentAliases.
    { division: null, department: "Отдел сетевого администрирования", count: 1 },
    // Сотрудник без указанного отдела в источнике численности — не сопоставляется ни с одним
    // ответом анкеты, учитывается только в общем итоге по компании.
    { division: null, department: "(не указан отдел)", count: 1 }
  ],

  index_: null,

  /**
   * {canonicalDepartment: {division, count}}, построено один раз за
   * запуск скрипта. Названия отделов приводятся через тот же
   * DepartmentAliases.canonicalize(), что и ответы анкеты в
   * Segments.splitBy / FilterEngine — иначе численность и респонденты
   * разъедутся по разным бакетам при переименовании отдела.
   */
  buildIndex_() {

    if (this.index_) return this.index_;

    const index = {};

    this.RAW_.forEach(entry => {

      const canonical = DepartmentAliases.canonicalize(entry.department);
      const existing = index[canonical];

      if (existing) {

        if (existing.division !== entry.division) {
          console.warn(
            "Headcount: отдел «" + canonical + "» встречается под разными управлениями (" +
            existing.division + " / " + entry.division + ") — оставлено первое"
          );
        }

        existing.count += entry.count;

      } else {
        index[canonical] = { division: entry.division, count: entry.count };
      }

    });

    this.index_ = index;
    return index;

  },

  /**
   * Численность и управление отдела по каноническому названию
   * (см. DepartmentAliases.canonicalize).
   *
   * @returns {{division: ?String, count: Number}|null} null, если
   *   отдела нет в справочнике численности.
   */
  forDepartment(canonicalDepartmentName) {

    const index = this.buildIndex_();
    const canonical = DepartmentAliases.canonicalize(canonicalDepartmentName);
    const entry = index[canonical];

    return entry ? { division: entry.division, count: entry.count } : null;

  },

  /**
   * Управление, к которому отнесен отдел, или null (в т.ч. для
   * отделов "не отнесено к управлению" и отделов вне справочника).
   */
  divisionOf(canonicalDepartmentName) {

    const entry = this.forDepartment(canonicalDepartmentName);
    return entry ? entry.division : null;

  },

  /**
   * Численность одного управления (или "Не отнесено к управлению").
   */
  forDivision(divisionName) {

    const index = this.buildIndex_();
    const isUnassigned = divisionName === this.UNASSIGNED_LABEL;

    const count = Object.keys(index).reduce((sum, dept) => {
      const entry = index[dept];
      const belongs = isUnassigned ? entry.division === null : entry.division === divisionName;
      return belongs ? sum + entry.count : sum;
    }, 0);

    return { count: count };

  },

  /**
   * Список управлений, встречающихся в справочнике (без null/не
   * отнесенных), в порядке первого появления в RAW_.
   */
  listDivisions() {

    const seen = {};
    const divisions = [];

    this.RAW_.forEach(entry => {
      if (entry.division && !seen[entry.division]) {
        seen[entry.division] = true;
        divisions.push(entry.division);
      }
    });

    return divisions;

  },

  UNASSIGNED_LABEL: "Не отнесено к управлению",

  /**
   * Численность всей компании по справочнику (включая "не отнесено").
   */
  total() {
    return this.RAW_.reduce((sum, entry) => sum + entry.count, 0);
  }

};
