      formula: "Сравнивается доля каждой группы среди респондентов в текущем и прошлом году; заметным считается сдвиг, отмеченный расчётом как существенный.",
      formulaPlain: "Если, например, доля офисных сотрудников среди ответивших упала, а офисные сотрудники в среднем лояльнее, — часть падения общего eNPS может объясняться просто тем, что офисных сотрудников среди отвечавших стало меньше, а не тем, что все стали менее лояльны.",
      howToRead: "При обнаруженном сдвиге состава в первую очередь стоит смотреть на когортное (парное) сравнение — оно очищено от этого эффекта.",
      limitations: "Проверка указывает лишь на возможность эффекта состава, а не доказывает его размер — точную величину вклада она не выделяет."
    }

  },

  /**
   * Живые примеры "Пример по этим данным: ..." — строятся из реально
   * посчитанных объектов текущего запуска (AnalyticsService), а не из
   * зафиксированного текста. Каждая функция берет ПЕРВУЮ подходящую
   * строку соответствующей таблицы (см. AnalyticsWriter.gs — она же
   * решает, что считать "подходящей", и передает сюда готовый объект)
   * и возвращает готовое предложение, либо null, если подходящих
   * данных в этом запуске нет (например, нет прошлого года).
   */
  EXAMPLE: {

    absoluteLevel(entry) {
      if (!entry || entry.status === null || entry.status === undefined) return null;
      return "Пример по этим данным: «" + entry.question + "» — " + entry.value + " " + entry.unit +
        ", статус " + entry.status + " (" + entry.statusExplained + ").";
    },

    significance(entry) {
      if (!entry || entry.previous === undefined || entry.previous === null) return null;
      return "Пример по этим данным: «" + entry.question + "» — " + entry.previous + " " + entry.unit +
        " → " + entry.value + " " + entry.unit + " (Δ " + entry.delta + "), " + entry.significanceNote + ".";
    },

    enpsConfidence(entry) {
      if (!entry || entry.margin === undefined) return null;
      const low = MathStats.round(entry.value - entry.margin, 1);
      const high = MathStats.round(entry.value + entry.margin, 1);
      return "Пример по этим данным: eNPS = " + entry.value + " ± " + entry.margin +
        " — истинное значение с высокой вероятностью лежит между " + low + " и " + high + ".";
    },

    coverage(entry) {
      if (!entry || entry.coveragePercent === null || entry.coveragePercent === undefined) return null;
      return "Пример по этим данным: «" + entry.question + "» — охват " + entry.coveragePercent + "%" +
        (entry.coverageDelta !== undefined ? ", Δ охвата " + entry.coverageDelta + " п.п." : "") + ".";
    },

    bottomShare(entry) {
      if (!entry || entry.bottomShare === undefined) return null;
      return "Пример по этим данным: «" + entry.question + "» — жёсткий негатив " + entry.bottomShare +
        "% при общей оценке " + entry.value + " " + entry.unit + ".";
    },

    uncertainGroup(entry) {
      if (!entry || !entry.uncertainGroup) return null;
      const g = entry.uncertainGroup;
      return "Пример по этим данным: по вопросу «" + entry.question + "» «затрудняюсь ответить» — " +
        g.n + " человек (" + g.percent + "%), eNPS " + g.enps + ", критиков " + g.criticsPercent + "%.";
    },

    correlation(entry) {
      if (!entry || entry.rEnps === null || entry.rEnps === undefined) return null;
      return "Пример по этим данным: «" + entry.question + "» — связь с eNPS r = " + entry.rEnps + ".";
    },

    driversQuadrant(row) {
      if (!row) return null;
      return "Пример по этим данным: «" + row.question + "» — уровень " + row.level +
        " из 100, связь с eNPS r = " + row.r + ", квадрант «" + row.quadrant + "».";
    },

    correlationMatrix(row) {
      if (!row || (row.burnout === undefined && row.leave === undefined)) return null;
      return "Пример по этим данным: «" + row.question + "» — связь с выгоранием r = " + row.burnout +
        ", с уходом r = " + row.leave + ".";
    },

    promoterGap(gap) {
      if (!gap) return null;
      return "Пример по этим данным: «" + gap.question + "» — промоутеры ставят " + gap.promoterMean +
        ", критики " + gap.detractorMean + ", разрыв " + gap.gap + ".";
    },

    segmentDeviation(segment, dimensionTitle) {
      if (!segment || !segment.deviations.length) return null;
      const text = segment.deviations
        .map(d => d.label + " " + (d.diff > 0 ? "+" : "") + MathStats.round(d.diff, 1))
        .join(", ");
      return "Пример по этим данным: «" + segment.name + "» (" + dimensionTitle + ") — " + text + ".";
    },

    sampleReliability(segment, dimensionTitle) {
      if (!segment) return null;
      return "Пример по этим данным: «" + segment.name + "» (" + dimensionTitle + ") — n = " + segment.n +
        (segment.fragile ? ", группа малая — результат сигнальный, а не факт." : ", группа достаточного размера.");
    },

    cohortPairedTest(row) {
      if (!row) return null;
      return "Пример по этим данным: «" + row.question + "» — Δ " + row.meanDiff + ", n = " + row.n +
        ", t = " + row.t + ". " + row.verdict + ".";
    },

    compositionShift(entry) {
      if (!entry || !entry.shifts.length) return null;
      const shift = entry.shifts[0];
      return "Пример по этим данным: " + entry.dimension + " — " + shift.name + " " +
        shift.sharePercentBefore + "% → " + shift.sharePercentNow + "% (" +
        (shift.shiftPp > 0 ? "+" : "") + shift.shiftPp + " п.п.).";
    }

  },

  /**
   * Статусы результата — единый человеческий словарь поверх
   * специализированных статусов (Norms.STATUS для абсолютного уровня,
   * квадранты Drivers, текстовые пометки Segments/Cohort). Отвечает не
   * на вопрос «какой уровень», а на вопрос «насколько этому
   * конкретному результату можно доверять и требует ли он действий».
   */
  STATUS: {
    EXPECTED: "В пределах ожидаемого",
    ATTENTION: "Стоит обратить внимание",
    REVIEW: "Требуется проверка",
    INSUFFICIENT: "Недостаточно данных для надёжного вывода",
    NO_COMPARISON: "Нет сравнения с прошлым годом"
  },

  STATUS_COLORS: {
    "В пределах ожидаемого": "#d9ead3",
    "Стоит обратить внимание": "#fff2cc",
    "Требуется проверка": "#f4cccc",
    "Недостаточно данных для надёжного вывода": "#cfe2f3",
    "Нет сравнения с прошлым годом": "#d9d2e9"
  },

  /**
   * @param {Object} params
   * @param {Boolean} params.insufficientData - мала база текущего года (сам
   *   текущий результат ненадёжен, а не только сравнение с прошлым годом)
   * @param {Boolean} params.noComparisonData - нет данных прошлого года для
   *   сравнения, при этом текущий результат сам по себе надёжен
   * @param {Boolean} params.negativeSignal - подтвержденный негативный сигнал
   * @param {Boolean} params.weakSignal - единичный/слабый сигнал
   * @returns {{label: String, color: String}}
   *
   * Порядок проверки важен: малая база текущего года перевешивает любой
   * сигнал (доверять выводу нельзя, даже если цифра выглядит плохо);
   * отсутствие сравнения с прошлым годом — отдельный, более слабый
   * статус (текущий результат сам по себе достоверен, недоступен только
   * тренд); дальше — подтвержденный негативный сигнал, затем слабый.
   */
  reliabilityStatus(params) {

    params = params || {};

    let label;

    if (params.insufficientData) label = this.STATUS.INSUFFICIENT;
    else if (params.noComparisonData) label = this.STATUS.NO_COMPARISON;
    else if (params.negativeSignal) label = this.STATUS.REVIEW;
    else if (params.weakSignal) label = this.STATUS.ATTENTION;
    else label = this.STATUS.EXPECTED;

    return { label: label, color: this.STATUS_COLORS[label] };

  }

};
