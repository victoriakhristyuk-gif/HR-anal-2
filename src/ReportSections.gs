/**
 * ==========================================================
 * Смысловые секции отчета (макет V3)
 * ==========================================================
 *
 * Этот файл отвечает ТОЛЬКО за визуальную структуру отчета (в каком
 * порядке и какими блоками вопросы показываются на листе). Он не
 * содержит и не влияет ни на расчеты (Statistics.gs/Comparison.gs),
 * ни на структуру самой анкеты (Questions.gs).
 *
 * Структура отчета (как сгруппированы вопросы на листе) и структура
 * анкеты (Questions.gs) — разные сущности. Questions.gs остается
 * единственным источником правды по самим вопросам (title, type,
 * answers и т.д.) — этот файл только определяет, в какую секцию
 * отчета и в каком порядке попадает каждый уже существующий вопрос.
 *
 * Секции макета V3 не всегда совпадают 1:1 с полем "group" в каталоге
 * Questions.gs — например, "Удовлетворенность работой и оплатой"
 * объединяет вопросы из групп Работа/Руководитель/Вознаграждение,
 * а "Карьера / Культура" — из групп Компания/Команда.
 *
 * eNPS сюда не входит — он отображается отдельно, в блоке
 * "Ключевые показатели", а не как секция детальной аналитики.
 */

const ReportSections = {

  // Порядок массива — это и есть порядок разделов "Детальной аналитики"
  // в отчете (см. ReportBuilder.createReport): первые четыре рендерятся
  // до блока "Средние оценки", "Офис"/"Бенефиты" — после него.
  sections: [
    {
      name: "👥 Состав выборки",
      questions: ["Город", "Отдел", "Стаж", "Формат работы"],
      // Внутри отчета (не в фильтре сайдбара) эти два вопроса
      // выводятся отсортированными по частоте ответа, а не по
      // алфавитному порядку каталога.
      sortByFrequency: ["Город", "Отдел"]
    },
    {
      name: "💼 Удовлетворенность работой и оплатой",
      questions: [
        "Work-life balance",
        "Задачи",
        "Ожидания",
        "Проф мнение",
        "Возможности роста",
        "ОС от руководителя",
        "Удовлетворенность рабочими задачами",
        "ЗП"
      ]
    },
    {
      name: "⚠️ Риски",
      questions: ["Выгорание", "Смена работы"]
    },
    {
      name: "🤍 Культура",
      questions: [
        "Ценности",
        "О жизни компании",
        "Цели компании",
        "Вклад",
        "Ценишь в компании",
        "Зоны роста компании",
        "Атмосфера в отделе",
        "Межкомандное взаимодействие",
        "Неформальное общение",
        "Решение споров"
      ]
    },
    {
      name: "Офис",
      // Визуально вложена в "Средние оценки" (см. ReportBuilder.renderSection_/
      // renderAverageOverviewSection_) — небольшой отступ перед названием.
      indent: true,
      questions: [
        "Рабочий стол",
        "Рабочее кресло",
        "Расположение рабочего места",
        "Офисное пространство",
        "Отдых в офисе",
        "Переговорки",
        "Питание и возможность перекусить, выпить чай, кофе",
        "Атмосфера в офисе",
        "Рабочая техника"
      ]
    },
    {
      name: "Бенефиты",
      indent: true,
      questions: ["Корпоративы", "Обучение", "Курсы английского", "ДМС", "Мерч за достижения"]
    }
  ],

  /**
   * Вернуть секции с полными объектами вопросов из Questions.gs,
   * в порядке, заданном картой секций (не в порядке колонок анкеты).
   */
  getSections() {

    const byTitle = {};
    Questions.getAll().forEach(question => { byTitle[question.title] = question; });

    return this.sections.map(section => ({
      name: section.name,
      indent: section.indent || false,
      sortByFrequency: section.sortByFrequency || [],
      questions: section.questions.map(title => {

        const question = byTitle[title];

        if (!question) {
          throw new Error("ReportSections: вопрос \"" + title + "\" не найден в Questions.gs");
        }

        return question;

      })
    }));

  },

  /**
   * Проверка, что ни один аналитический вопрос (report:true, кроме
   * eNPS — он вне секций) не "потерялся": не был добавлен ни в одну
   * секцию, например, после появления нового вопроса в Questions.gs
   * без обновления этой карты. (Несуществующий/неаналитический вопрос
   * в самой карте уже отдельно ловит getSections().)
   */
  validate() {

    const analyticalTitles = Questions.getAll()
      .filter(question => question.report && question.type !== "enps")
      .map(question => question.title);

    const mappedTitles = this.sections.reduce(
      (titles, section) => titles.concat(section.questions),
      []
    );

    const missing = analyticalTitles.filter(title => mappedTitles.indexOf(title) === -1);

    if (missing.length > 0) {
      throw new Error("ReportSections: не распределены в секции: " + missing.join(", "));
    }

  }

};
